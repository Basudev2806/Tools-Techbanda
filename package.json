{
  "name": "tools-techbanda",
  "private": true,
  "version": "0.1.0",
  "description": "Developer utilities suite for tools.techbanda.com",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"pnpm run dev -w server\" \"pnpm run dev -w client\"",
    "dev:server": "pnpm run dev -w server",
    "dev:client": "pnpm run dev -w client",
    "build": "pnpm run build -w client",
    "start": "pnpm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
